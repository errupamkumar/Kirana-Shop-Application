# Copy to .env (never commit .env). Read by docker compose, the backend
# (spring.config.import), admin-web (Vite envDir) and customer-app (app.config.ts).
# Keep comments on their own lines: the backend parses this file as .properties.

# ---- Database ----
# Host port 3307 avoids a clash with a locally installed MySQL on 3306
MYSQL_IMAGE=container-registry.oracle.com/mysql/community-server:8.4
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root
DB_URL=jdbc:mysql://localhost:3307/kirana
DB_USER=kirana
DB_PASSWORD=change-me

# ---- Security ----
# HS256 signing key, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
# AES-256-GCM key (base64 of 32 bytes) for the payment gateway secret. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# First admin, created at startup when no admin exists
ADMIN_EMAIL=admin@kirana.local
ADMIN_PASSWORD=change-me-admin
# Comma separated admin-web origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- OTP ----
# logging (dev: prints the code) or msg91
OTP_PROVIDER=logging
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Payments ----
RAZORPAY_WEBHOOK_SECRET=

# ---- Media (uploaded product images) ----
MEDIA_DIR=./media

# ---- Clients ----
VITE_API_BASE_URL=http://localhost:8080
# Android emulator reaches the host machine at 10.0.2.2; use your LAN IP for a real device
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
