# Production settings for deploy/docker-compose.prod.yml. Copy to .env.prod on the server and fill in.
# Never commit .env.prod. Generate secrets on the server with the commands shown.

# ---- Hostnames ----
# With your own domain: admin.mystore.in, shop.mystore.in, api.mystore.in (A records -> server IP).
# Without a domain, use sslip.io names built from the server's public IP (dots become dashes):
ADMIN_HOST=admin.203-0-113-10.sslip.io
SHOP_HOST=shop.203-0-113-10.sslip.io
API_HOST=api.203-0-113-10.sslip.io
# Let's Encrypt account email (certificate expiry notices)
ACME_EMAIL=owner@example.com

# ---- Database ----
# openssl rand -hex 16
MYSQL_ROOT_PASSWORD=
DB_USER=kirana
# openssl rand -hex 16
DB_PASSWORD=

# ---- Security ----
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (keep a copy: losing it makes the stored Razorpay secret unreadable)
APP_ENCRYPTION_KEY=
# First admin login (created on first start)
ADMIN_EMAIL=owner@example.com
# At least 12 characters
ADMIN_PASSWORD=

# ---- Customer login (OTP by SMS) ----
# logging = codes are written to the backend log (testing only); msg91 = real SMS
OTP_PROVIDER=logging
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Demo/test numbers that always accept 123456 (comma separated, +91...). Leave EMPTY for a real launch.
OTP_TEST_NUMBERS=+919999999999

# ---- Images ----
# Base image registry for builds (Docker Hub). If Docker Hub downloads fail, use Google's mirror: mirror.gcr.io/library
BASE_REGISTRY=docker.io/library
# MySQL server image (Docker Hub). Alternative source: container-registry.oracle.com/mysql/community-server:8.4
MYSQL_IMAGE=mysql:8.4

# ---- Online payments ----
RAZORPAY_WEBHOOK_SECRET=
