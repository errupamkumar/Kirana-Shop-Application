# Three hostnames, automatic HTTPS (Let's Encrypt) for each.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), payment=()"
		-Server
	}
}

# REST API, uploaded media and health check
{$API_HOST} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 4MB
	}
	reverse_proxy backend:8080
}

# Admin web (single-page app)
{$ADMIN_HOST} {
	import security_headers
	encode zstd gzip
	root * /srv/admin
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# Customer web app (Expo web export)
{$SHOP_HOST} {
	import security_headers
	encode zstd gzip
	root * /srv/shop
	header /_expo/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}.html /index.html
	file_server
}
